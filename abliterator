#!/bin/bash
# The Abliterator command line (Magenta RT 2 engine). See backend/abliterator/cli.py.
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$DIR/.venv-mrt2/bin/python"
[ -x "$PY" ] || { echo "No .venv-mrt2 yet. Run ./setup.sh --mrt2 first." >&2; exit 1; }
cd "$DIR" && PYTHONPATH="$DIR/backend" exec "$PY" -m abliterator.cli "$@"
